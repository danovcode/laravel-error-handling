{
    "name": "dwiky-danov/business-error-handler",
    "description": "Framework-agnostic global error handling with safe API responses and optional Kibana logging.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "psr/log": "^3.0"
    },
    "suggest": {
        "illuminate/console": "Required for the optional Laravel Artisan command.",
        "illuminate/support": "Required for Laravel service-provider auto-discovery.",
        "monolog/monolog": "A PSR-3 logger implementation."
    },
    "autoload": {
        "psr-4": {
            "BusinessErrorHandler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BusinessErrorHandler\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BusinessErrorHandler\\Laravel\\ErrorHandlerServiceProvider"
            ]
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    }
}
